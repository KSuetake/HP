# WordPress REST API / MCP Authentication Settings
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to Git repository!

# WordPress Site URL (e.g., https://stk-lab.org)
WP_SITE_URL=https://stk-lab.org

# WordPress Username (login username or display username with edit capability)
WP_USERNAME=your_username

# WordPress Application Password (generated from WP Admin > Users > Profile > Application Passwords)
# Format: xxxx xxxx xxxx xxxx xxxx xxxx (spaces are optional and will be stripped automatically)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
